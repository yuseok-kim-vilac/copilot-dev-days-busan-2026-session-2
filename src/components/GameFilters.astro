---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
    /** Number of games shown before any filter is applied. */
    total: number;
}

const { categories, publishers, total } = Astro.props;

const focusRing = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    class="mb-6 bg-slate-800/60 backdrop-blur-sm border border-slate-700 rounded-xl p-4 space-y-4"
    aria-label="Filter games"
    data-testid="game-filters"
    data-total={total}
>
    <fieldset>
        <legend class="text-sm font-semibold text-slate-200 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-1.5 text-sm text-slate-200 hover:bg-slate-700 transition-colors duration-200 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-900/40 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="filter-publisher" class="block text-sm font-semibold text-slate-200 mb-2">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class={`rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 ${focusRing}`}
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>

        <button
            type="reset"
            class={`rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-700 transition-colors duration-200 ${focusRing}`}
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>

    <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-count">
        Showing {total} of {total} games
    </p>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const noMatches = document.querySelector<HTMLElement>('[data-testid="filter-no-matches"]');
    const count = form?.querySelector<HTMLElement>('[data-testid="filter-count"]');
    const publisherSelect = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const categoryBoxes = Array.from(
        form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? [],
    );

    /** Show only cards in any selected category (OR) that also match the publisher (AND). */
    function applyFilters(): void {
        if (!form || !count) return;

        const selectedCategories = categoryBoxes.filter((box) => box.checked).map((box) => box.value);
        const publisher = publisherSelect?.value ?? '';

        let visible = 0;
        for (const card of cards) {
            const matchesCategory =
                selectedCategories.length === 0 ||
                selectedCategories.includes(card.dataset.categoryId ?? '');
            const matchesPublisher = publisher === '' || card.dataset.publisherId === publisher;
            const show = matchesCategory && matchesPublisher;
            card.hidden = !show;
            if (show) visible++;
        }

        count.textContent = `Showing ${visible} of ${cards.length} games`;
        if (grid) grid.hidden = visible === 0;
        if (noMatches) noMatches.hidden = visible !== 0;

        const params = new URLSearchParams();
        selectedCategories.forEach((id) => params.append('category', id));
        if (publisher !== '') params.set('publisher', publisher);
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    /** Restore the selection from the URL so filtered views can be shared. */
    function restoreFromUrl(): void {
        const params = new URLSearchParams(location.search);
        const categories = params.getAll('category');
        categoryBoxes.forEach((box) => {
            box.checked = categories.includes(box.value);
        });
        const publisher = params.get('publisher') ?? '';
        if (publisherSelect) {
            publisherSelect.value = publisher;
            // Ignore ids that don't exist so the select never ends up blank.
            if (publisherSelect.value !== publisher) publisherSelect.value = '';
        }
    }

    if (form) {
        restoreFromUrl();
        applyFilters();
        form.addEventListener('change', applyFilters);
        form.addEventListener('reset', () => {
            // The reset event fires before the controls are cleared.
            setTimeout(applyFilters, 0);
        });
        form.addEventListener('submit', (event) => event.preventDefault());
    }
</script>
